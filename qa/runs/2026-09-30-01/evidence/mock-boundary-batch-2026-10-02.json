        "source": "const root='/Users/tamastyukodi/Development/video-platform-ui';\nconst axiosModule=require('/Users/tamastyukodi/Development/video-platform-ui/node_modules/axios');\nconst axios=axiosModule.default;\nconst identity=new URLSearchParams(window.location.search).get('qaRole') || 'CREATOR';\nconst events=[];\nlet capturedAdapter;\nconst guard=async config=>{\n events.push({transport:'axios-guard',method:config.method,url:config.url,role:identity,status:config.url==='api/user/userInfo'?(identity==='GUEST'?401:200):503});\n renderEvents();\n if(config.url==='api/user/userInfo' && identity!=='GUEST')return {status:200,statusText:'OK',data:{id:'qa-boundary-identity',firstName:'Boundary',lastName:'Fixture',email:'boundary@example.test',roles:[identity],onboardingCompleted:true},headers:{},config};\n const status=config.url==='api/user/userInfo' && identity==='GUEST'?401:503;\n throw new axiosModule.AxiosError('Blocked by isolated QA transport','QA_NETWORK_DENIED',config,null,{status,statusText:'QA captured',data:{message:'No real network allowed'},headers:{},config});\n};\naxios.defaults.adapter=guard;\nwindow.fetch=async(url,options)=>{events.push({transport:'fetch-guard',method:options?.method||'GET',url:String(url),role:identity});renderEvents();throw new Error('QA_NETWORK_DENIED: storage PUT captured locally');};\nfunction renderEvents(){const out=document.getElementById('qa-boundary-events');if(out)out.textContent=JSON.stringify(events,null,2);}\nconst http=require('/Users/tamastyukodi/Development/video-platform-ui/src/core/api/http-client.ts').default;\ncapturedAdapter=http.defaults.adapter===guard;\nconst dashboard=require('/Users/tamastyukodi/Development/video-platform-ui/src/core/api/services/dashboard/dashboard-api.ts');\nconst products=require('/Users/tamastyukodi/Development/video-platform-ui/src/core/api/services/products/product-crud-api.ts');\nconst uploads=require('/Users/tamastyukodi/Development/video-platform-ui/src/core/api/services/uploads/upload-lifecycle.ts');\nconst panel=document.createElement('section');panel.setAttribute('aria-label','Isolated mock boundary probes');panel.style.cssText='padding:16px;background:white;color:black;position:relative;z-index:100;font:16px sans-serif';\nconst title=document.createElement('h1');title.textContent='Isolated mock boundary probes';panel.appendChild(title);\nconst mode=document.createElement('p');mode.textContent=`Mock flag: ${process.env.REACT_APP_USE_MOCKS}; identity fixture: ${identity}; runtime adapter is network guard: ${capturedAdapter}`;panel.appendChild(mode);\nconst output=document.createElement('pre');output.id='qa-boundary-result';output.setAttribute('role','status');output.textContent='No probe run';\nfunction addButton(label,action){const button=document.createElement('button');button.textContent=label;button.style.cssText='margin:4px;padding:8px';button.onclick=async()=>{button.disabled=true;try{const result=await action();output.textContent=JSON.stringify({probe:label,outcome:'resolved',...result},null,2);}catch(error){output.textContent=JSON.stringify({probe:label,outcome:'rejected',http_status:error.response?.status||null,message:error.message},null,2);}finally{button.disabled=false;renderEvents();}};panel.appendChild(button);}\naddButton('Run reporting client',async()=>({data:await dashboard.getCreatorDashboardSummaryAPI()}));\naddButton('Run Product client',async()=>({data:await products.getProductByIdAPI('qa-boundary-product')}));\nconst file=new File(['Synthetic in-memory boundary test'],'qa-boundary.txt',{type:'text/plain'});\naddButton('Try matching mock prefix',async()=>{const response=await uploads.uploadToStorageTarget({uploadUrl:'mock-upload://download-section/qa-boundary',file,mockProtocolPrefix:'mock-upload://download-section/'});return {status:response.status,ok:response.ok};});\naddButton('Try different mock prefix',async()=>{const response=await uploads.uploadToStorageTarget({uploadUrl:'mock-upload://other-target/qa-boundary',file,mockProtocolPrefix:'mock-upload://download-section/'});return {status:response.status,ok:response.ok};});\naddButton('Try ordinary storage URL',async()=>{const response=await uploads.uploadToStorageTarget({uploadUrl:'http://127.0.0.1:9/qa-storage',file,mockProtocolPrefix:'mock-upload://download-section/'});return {status:response.status,ok:response.ok};});\npanel.appendChild(output);const eventOutput=document.createElement('pre');eventOutput.id='qa-boundary-events';eventOutput.setAttribute('aria-label','Captured local requests');panel.appendChild(eventOutput);document.body.prepend(panel);renderEvents();\nconsole.info('[QA boundary]',process.env.REACT_APP_USE_MOCKS,identity,'runtime adapter is guard',capturedAdapter);\nimport('/Users/tamastyukodi/Development/video-platform-ui/src/index.tsx');\n"
