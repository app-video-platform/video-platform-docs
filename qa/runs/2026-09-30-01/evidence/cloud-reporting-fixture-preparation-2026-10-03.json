['conname']+' '+c['definition']+';')\n ddl.extend(['CREATE UNIQUE INDEX uk_user_roles_user_id ON user_roles(user_id);','CREATE UNIQUE INDEX uk_product_entitlements_purchase_order_item ON product_entitlements(purchase_order_item_id) WHERE purchase_order_item_id IS NOT NULL;'])\n for r in schema['roles']:ddl.append(\"INSERT INTO roles(role_id,role_name) VALUES (\"+str(r['role_id'])+\",'\"+r['role_name']+\"');\")\n ddl.extend([\"INSERT INTO users(user_id,email,password,enabled,first_name,last_name) VALUES ('a1ebdc7a-d497-4334-9fed-309aec071b25','local-owner@example.invalid','disabled',false,'Local','Owner');\",\"INSERT INTO user_roles(user_id,role_id) SELECT 'a1ebdc7a-d497-4334-9fed-309aec071b25',role_id FROM roles WHERE role_name='CREATOR';\"])\n sql('\\n'.join(ddl))\n baseline=sql(\"SELECT json_build_object('users',(SELECT json_agg(u ORDER BY user_id) FROM users u),'roles',(SELECT json_agg(r ORDER BY role_id) FROM roles r),'user_roles',(SELECT json_agg(ur ORDER BY user_id) FROM user_roles ur));\").stdout\n # Collision midway through customer insertion must roll back earlier inserts.\n sql(\"INSERT INTO users(user_id,email,password,enabled) VALUES (md5('vpqa:2026-10-03:reporting-v1:customer:1')::uuid,'collision@example.invalid','disabled',false);\")\n failed=run([pgbin/'psql','-X','-h',root/'socket','-p','54412','-d','video_platform_db','-f',seed],False)\n assert failed.returncode!=0\n assert sql(\"SELECT count(*) FROM users WHERE user_id=md5('vpqa:2026-10-03:reporting-v1:customer:0')::uuid;\").stdout.strip()=='0'\n sql(\"DELETE FROM users WHERE email='collision@example.invalid';\")\n first=run([pgbin/'psql','-X','-h',root/'socket','-p','54412','-d','video_platform_db','-f',seed])\n counts=json.loads(sql(\"SELECT json_build_object('users',(SELECT count(*)-1 FROM users),'products',(SELECT count(*) FROM course_products)+(SELECT count(*) FROM download_products),'orders',(SELECT count(*) FROM commerce_orders),'items',(SELECT count(*) FROM commerce_order_items),'attempts',